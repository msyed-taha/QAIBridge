# ── QAIbridge Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your own values.

# JWT
JWT_SECRET_KEY=qaibridge-change-this-to-a-long-random-string-in-production

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://qaibridge_user:qaibridge_dev_pw@localhost:5432/qaibridge

# ── Administrator allowlist (REQUIRED) ────────────────────────────────────────
# The ONLY email addresses permitted to hold the "admin" role. Comma-separated.
# Every path that grants admin (dashboard, first-admin setup, make_admin.py) and
# every admin request is checked against this list, so a role set directly in the
# database is still not treated as admin unless the email is listed here.
#   - exact address:  alice@gmail.com,bob@gmail.com
#   - whole domain:    @mycompany.com
# Add "@example.com" as well if you run the backend test suite.
ADMIN_EMAILS=you@gmail.com,teammate@gmail.com

# Owner / super-admin (optional). This account is always an active admin and
# can't be demoted, deactivated or deleted — not by other admins, not by itself.
# OWNER_EMAIL=you@gmail.com

# CORS: comma-separated list of frontend origins allowed to call this API.
# Defaults to the local dev origins below if unset — only needed when
# deploying to a real domain (e.g. a demo server for the FYP defense).
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# ── Module 5 AI engine (optional) ─────────────────────────────────────────────
# With a key, the Logic Transformer uses an LLM to understand classical code
# (any language / plain English). Without one it uses the offline analyzer.
# Anthropic keys (sk-ant-…) are detected automatically; any other key is used
# with an OpenAI-compatible API (OpenAI, Groq, OpenRouter, a local Ollama …).
# LLM_API_KEY=
# LLM_PROVIDER=anthropic            # anthropic | openai
# LLM_MODEL=claude-opus-5-5         # e.g. claude-sonnet-5, claude-haiku-4-5-20251001, gpt-4o-mini
# LLM_BASE_URL=                     # only for OpenAI-compatible servers, e.g. https://api.groq.com/openai/v1

# ── Simulation limits (optional) ──────────────────────────────────────────────
# MAX_CONCURRENT_SIMULATIONS=2      # heavy simulations allowed at the same time

# ── Email (required for OTP verification) ─────────────────────────────────────
#
# STEP 1: Use your Gmail address below
# STEP 2: Create a Gmail App Password (NOT your regular Google password):
#         Google Account → Security → 2-Step Verification → App Passwords
#         Select "Mail" + "Windows Computer" → Generate → copy the 16-char password
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
