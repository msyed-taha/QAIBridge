# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# OpenAI / LangChain API key (Module 5 – AST Transformer)
# Encrypted at rest per SRS SEC-2
OPENAI_API_KEY=sk-your-key-here

# HuggingFace token (alternative LLM for Module 5)
HF_TOKEN=hf-your-token-here

# Backend port (default 8000)
BACKEND_PORT=8000

# Frontend port (default 3000)
FRONTEND_PORT=3000
